# This is an example environment file.
# Copy this file to .env (cp .env.example .env) and customize it for your local development environment.

# Database settings
DB_USER=postgres
DB_PASS=postgres
DB_NAME=investment_analysis

# Financial Modeling Prep API Key (required for fetching financial data)
# Get a free API key at: https://financialmodelingprep.com/developer/docs/
FMP_API_KEY=your_api_key_here

# Redis cache (optional — FastAPI degrades gracefully if unavailable)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300

# --- Astra DB & GPU Orchestrator Settings ---

# 🌐 Cloud Provider Note: Astra DB is multi-cloud (AWS, GCP, Azure). 
# This project specifically targets GCP us-east1 for low-latency alpha signals.

# Found in Astra Portal -> Settings -> Token Management
# Matches the ${ASTRA_DB_TOKEN} variable used in docker-compose.yml
ASTRA_DB_TOKEN=AstraCS:... 

# Found in Astra Portal -> Database Overview -> API Endpoint
# Format: https://<db-id>-<region>.apps.astra.datastax.com
# Example (GCP): https://fa7c268b-cff1-49ee-8f63-39b4e853d370-us-east1.apps.astra.datastax.com
ASTRA_DB_API_ENDPOINT=your_endpoint_here
ASTRA_DB_KEYSPACE=alpha_signals

# 🏎️ Hardware Signaling (Matches SKILL.md constraints)
# Note: Using Astra Vectorize allows H100 performance via API, bypassing local VRAM limits.
EMBEDDING_MODEL_ID=nvidia/nv-embedqa-e5-v5
VECTOR_COMPUTE_HARDWARE=h100-tensor-core
ALLOW_DEGRADED_STATE=true
