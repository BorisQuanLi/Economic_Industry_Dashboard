# --- Infrastructure: Database & Cache ---
# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASS=postgres
DB_NAME=superhost_db
DB_HOST=postgres  # Added for docker-compose networking

# Redis & Caching (Used for GraphQL subscriptions and task queuing)
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=300

# --- Integration: Google Cloud Platform ---
# Path to service account key file (local dev)
GOOGLE_APPLICATION_CREDENTIALS=./service-account-file.json
GCP_PROJECT_ID=superhost-api-gateway
GCP_REGION=us-east1

# --- Integration: External APIs ---
FMP_API_KEY=your_api_key_here

# --- AI & Vector Engine (Astra DB / NVIDIA) ---
# Targets GCP us-east1 for low-latency inference
ASTRA_DB_TOKEN=AstraCS:...
ASTRA_DB_API_ENDPOINT=https://<db-id>-us-east1.apps.astra.datastax.com
ASTRA_DB_KEYSPACE=superhost_signals
EMBEDDING_MODEL_ID=nvidia/nv-embedqa-e5-v5
ALLOW_DEGRADED_STATE=true

# --- Application Settings ---
APP_ENV=development
LOG_LEVEL=info
JSON_LOGGING=true
ALLOW_INTROSPECTION=true
